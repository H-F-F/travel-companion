AMAP_API_KEY=your_amap_web_key
MCP_12306_URL=http://127.0.0.1:8001/mcp
AMAP_NEAREST_RAIL_FIRST=0

# ---- LLM 规划 Agent（可选，P0）----
# 未配置时自动降级为规则引擎；配置后对话模式使用大模型编排工具生成行程。
# 任意 OpenAI 兼容端点均可，例如：
#   DeepSeek : https://api.deepseek.com/v1
#   通义千问 : https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱     : https://open.bigmodel.cn/api/paas/v4
#   豆包 Ark : https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30

# ---- 账号体系（可选但推荐）----
# JWT 签名密钥：不配置会用开发默认值，正式环境务必改成随机长字符串
JWT_SECRET=change-me-to-a-long-random-string

# ---- 演示模式（可选）----
# DEMO_MODE=1 时强制禁用 LLM，走规则引擎内置数据，不依赖任何外部 API。
# 面试 / 现场演示推荐开启，保证演示不因外部服务波动而翻车。
DEMO_MODE=0
